@{
    ViewData["Title"] = "TechNova Solutions - Tienda de Tecnología y Soluciones Informáticas";
}

@section MetaTags {
    <meta name="description" content="Bienvenido a TechNova Solutions, tu tienda en línea de confianza para componentes, equipos de cómputo y soporte técnico especializado." />
    <meta name="keywords" content="tecnología, computadoras, hardware, tienda en línea, soporte TI" />
}

<div class="text-center my-5">
    <h1 class="display-4 fw-bold text-primary">Bienvenido a TechNova Solutions</h1>
    <h2 class="lead text-secondary">Innovación, hardware y soluciones tecnológicas a tu alcance</h2>
    <p class="mt-3">Explora nuestro catálogo optimizado y descubre el mejor rendimiento para tus proyectos.</p>
</div>

<hr class="my-4">

<div class="row">
    <div class="col-12">
        <h3 class="mb-4">Catálogo de Productos Destacados</h3>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        @foreach (var producto in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h4 class="card-title text-dark">@producto.Nombre</h4>
                        <p class="card-text text-muted">@producto.Descripcion</p>
                        <p class="card-text fw-bold text-success">$@producto.Precio MXN</p>
                        <p class="card-text"><small class="text-muted">Stock disponible: @producto.Stock</small></p>
                        <a href="#" class="btn btn-primary">Comprar Ahora</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info text-center" role="alert">
                Próximamente agregaremos productos a nuestro inventario desde la base de datos de XAMPP.
            </div>
        </div>
    }
</div>